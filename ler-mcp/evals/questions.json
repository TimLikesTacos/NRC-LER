    {
      "id": "sequoyah-period-counts",
      "question": "How many LERs did Sequoyah publish 2010-2016 compared to 2018-2024?",
      "call": {
        "tool": "summarize_events",
        "args": {
          "plant": "Sequoyah",
          "date_from": "2010",
          "date_to": "2016",
          "group_by": "year"
        }
      },
      "checks": [
        {
          "path": "/total_events",
          "op": "min",
