    {
      "id": "biggest-contributor",
      "question": "Summarize the biggest contributor to an event",
      "call": {
        "tool": "summarize_events",
        "args": {
          "group_by": "cause"
        }
      },
      "checks": [
        {
          "path": "/groups/0/value",
          "op": "one_of",
